{
  "permissions": {
    "allow": [
      "Bash(flutter *)",
      "Bash(dart *)",
      "Bash(cd android && ./gradlew *)",
      "Bash(cd android && ./gradlew *)",
      "Bash(bash scripts/*)",
      "Bash(./scripts/*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git push -u origin task/*)",
      "Bash(git push origin task/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)"
    ],
    "deny": [
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/key.properties)",
      "Read(**/.env*)",
      "Write(**/*.jks)",
      "Write(**/*.keystore)",
      "Write(**/key.properties)",
      "Write(**/.env*)",
      "Edit(**/*.jks)",
      "Edit(**/*.keystore)",
      "Edit(**/key.properties)",
      "Edit(**/.env*)",
      "Bash(git push * main)",
      "Bash(git push origin main)",
      "Bash(git push --force*)",
      "Bash(rm -rf [!b]*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session_start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard_generated.sh \"$CLAUDE_FILE_PATH\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard_commands.sh \"$CLAUDE_TOOL_INPUT\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/autoformat.sh \"$CLAUDE_FILE_PATH\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/preflight.sh"
          }
        ]
      }
    ]
  }
}
